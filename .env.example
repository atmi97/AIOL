# Copy to .env.local and fill in values.
# -----------------------------------------------------------------------------
# Database — SQLite for local/MVP. Swap to "postgresql://..." and update
# prisma/schema.prisma datasource provider for production.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js — required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Microsoft Entra SSO (primary). Register an app in Entra and paste values.
# Leave blank to disable Entra in dev; magic-link/dev-login still works.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Email magic link (fallback). Any SMTP works — point at Azure Communication
# Services, Resend SMTP, or your internal relay. Leave blank to disable.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@3shealth.ca"

# Dev fallback — when true, /signin shows a "dev-login" button that issues a
# session for any email without sending mail. Never enable in production.
ENABLE_DEV_LOGIN="true"

# First admin — the first user signing in with this email is auto-promoted to ADMIN.
INITIAL_ADMIN_EMAIL=""
